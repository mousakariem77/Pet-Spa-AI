# Copy to backend/.env and fill in the key. Get a free key at https://openrouter.ai/keys
# Leave OPENROUTER_API_KEY empty: AI falls back to rule engine + template answers (no errors).
OPENROUTER_API_KEY=
# Free models, tried in order (comma separated)
OPENROUTER_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT=20
